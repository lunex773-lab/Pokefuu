 {
  "id": "library_librarian",
  "commands": [
   {
    "cmd": "if",
    "when": {
     "flag": "book_done"
    },
    "then": [
     {
      "cmd": "say",
      "speaker": "司書",
      "text": "返してくれて、ありがとう。……十六年ぶりに、棚が埋まったわ。"
     },
     {
      "cmd": "end"
     }
    ]
   },
   {
    "cmd": "if",
    "when": {
     "hasItem": "missing_book"
    },
    "then": [
     {
      "cmd": "say",
      "speaker": "司書",
      "text": "……この本。どこで、これを？"
     },
     {
      "cmd": "say",
      "text": "司書は、表紙をそっとなでた。"
     },
     {
      "cmd": "say",
      "speaker": "司書",
      "text": "貸出カードの最後の欄……十六年前ね。判子は『黒雨』。……聞いたことのない名前だわ。"
     },
     {
      "cmd": "say",
      "speaker": "司書",
      "text": "とにかく、ありがとう。お礼にこれを。昔、神社の人が置いていったものなの。"
     },
     {
      "cmd": "takeItem",
      "item": "missing_book",
      "qty": 1
     },
     {
      "cmd": "giveItem",
      "item": "strong_ofuda",
      "qty": 2
     },
     {
      "cmd": "money",
      "amount": 800
     },
     {
      "cmd": "sfx",
      "id": "item"
     },
     {
      "cmd": "toast",
      "text": "強い御札 ×2 と 800円を受け取った"
     },
     {
      "cmd": "setFlag",
      "key": "book_done",
      "value": true
     },
     {
      "cmd": "end"
     }
    ]
   },
   {
    "cmd": "if",
    "when": {
     "flag": "book_quest"
    },
    "then": [
     {
      "cmd": "say",
      "speaker": "司書",
      "text": "『裏層覚書』……もし見つけたら、返してね。"
     },
     {
      "cmd": "if",
      "when": {
       "all": [
        {
         "flag": "wonders_quest"
        },
        {
         "notFlag": "wonder_book"
        }
       ]
      },
      "then": [
       {
        "cmd": "setFlag",
        "key": "wonder_book",
        "value": true
       },
       {
        "cmd": "incFlag",
        "key": "wonders"
       },
       {
        "cmd": "sfx",
        "id": "item"
       },
       {
        "cmd": "toast",
        "text": "七不思議を記録した：返ってこない本"
       }
      ]
     },
     {
      "cmd": "end"
     }
    ]
   },
   {
    "cmd": "say",
    "speaker": "司書",
    "text": "いらっしゃい。図書室では静かにね。"
   },
   {
    "cmd": "say",
    "speaker": "司書",
    "text": "……七不思議？ ああ、『返ってこない本』のことかしら。"
   },
   {
    "cmd": "say",
    "speaker": "司書",
    "text": "十六年前に貸し出されたきり、戻ってこない本があるの。題名は『裏層覚書』。"
   },
   {
    "cmd": "say",
    "speaker": "司書",
    "text": "変な話よね。貸出記録はあるのに、誰が借りたのか、誰も覚えていないの。"
   },
   {
    "cmd": "say",
    "speaker": "司書",
    "text": "もしどこかで見つけたら、返してくれると嬉しいわ。"
   },
   {
    "cmd": "setFlag",
    "key": "book_quest",
    "value": true
   },
   {
    "cmd": "if",
    "when": {
     "all": [
      {
       "flag": "wonders_quest"
      },
      {
       "notFlag": "wonder_book"
      }
     ]
    },
    "then": [
     {
      "cmd": "setFlag",
      "key": "wonder_book",
      "value": true
     },
     {
      "cmd": "incFlag",
      "key": "wonders"
     },
     {
      "cmd": "sfx",
      "id": "item"
     },
     {
      "cmd": "toast",
      "text": "七不思議を記録した：返ってこない本"
     }
    ]
   },
   {
    "cmd": "say",
    "text": "（寄り道：『裏層覚書』を探して返そう）"
   }
  ]
 },

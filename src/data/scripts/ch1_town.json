 {
  "id": "town_pond",
  "commands": [
   {
    "cmd": "if",
    "when": {
     "phase": [
      "night",
      "midnight"
     ]
    },
    "then": [
     {
      "cmd": "say",
      "text": "暗い水面に、自分が映っている。"
     },
     {
      "cmd": "wait",
      "ms": 600
     },
     {
      "cmd": "say",
      "text": "……すこし遅れて、隣にもう一人。小さな影が。"
     },
     {
      "cmd": "sfx",

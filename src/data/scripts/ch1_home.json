     },
     {
      "cmd": "setFlag",
      "key": "got_mem_photo",
      "value": true
     }
    ],
    "else": [
     {
      "cmd": "say",
      "text": "切り取られた家族写真。母の腕は、誰かを抱いた形のままだ。"
     }
    ]
   }
  ]
 },
